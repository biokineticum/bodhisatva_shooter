<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>Bodhisattva</AssemblyName>
    <RootNamespace>Bodhisattva</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <None Remove="**\*.xml" />
    <None Include="haarcascade_frontalface_default.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="headtrack.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <Target Name="CopyPlayableToGameRoot" AfterTargets="Build">
    <PropertyGroup>
      <GameRoot>$(MSBuildProjectDirectory)\..</GameRoot>
    </PropertyGroup>
    <ItemGroup>
      <PlayFiles Include="$(TargetDir)Bodhisattva.exe" />
      <PlayFiles Include="$(TargetDir)Bodhisattva.dll" />
      <PlayFiles Include="$(TargetDir)Bodhisattva.deps.json" />
      <PlayFiles Include="$(TargetDir)Bodhisattva.runtimeconfig.json" />
      <PlayFiles Include="$(TargetDir)OpenCvSharp.dll" />
      <PlayFiles Include="$(TargetDir)OpenCvSharpExtern.dll" />
      <PlayFiles Include="$(TargetDir)opencv_videoio_ffmpeg4100_64.dll" />
      <PlayFiles Include="$(TargetDir)haarcascade_frontalface_default.xml" />
      <PlayFiles Include="$(TargetDir)Microsoft.Web.WebView2.Core.dll" />
      <PlayFiles Include="$(TargetDir)Microsoft.Web.WebView2.WinForms.dll" />
      <PlayFiles Include="$(TargetDir)WebView2Loader.dll" />
      <PlayFiles Include="$(MSBuildProjectDirectory)\headtrack.py" />
    </ItemGroup>
    <Copy SourceFiles="@(PlayFiles)" DestinationFolder="$(GameRoot)" SkipUnchangedFiles="false" ContinueOnError="true" />
  </Target>
</Project>
